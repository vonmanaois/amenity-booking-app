generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  USER
  SUPERUSER
}

enum LocationMembershipRole {
  RESIDENT
  STAFF
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum AmenityType {
  PARTY_ROOM
  MEETING_ROOM
  GYM
  COURT
  OTHER
}

enum AmenityStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
}

model User {
  id               String               @id @default(cuid())
  authUserId       String?              @unique
  email            String               @unique
  name             String
  phone            String?
  platformRole     PlatformRole         @default(USER)
  passwordHash     String?
  memberships      LocationMembership[]
  bookings         Booking[]            @relation("ResidentBookings")
  approvedBookings Booking[]            @relation("BookingApprover")
  auditLogs        AuditLog[]           @relation("AuditActor")
  createdLocations Location[]           @relation("LocationCreator")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Location {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  addressLine1    String
  addressLine2    String?
  city            String
  province        String
  postalCode      String?
  country         String               @default("Canada")
  timezone        String               @default("America/Toronto")
  status          LocationStatus       @default(ACTIVE)
  createdById     String?
  createdBy       User?                @relation("LocationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships     LocationMembership[]
  amenities       Amenity[]
  bookings        Booking[]
  blackoutDates   BlackoutDate[]
  auditLogs       AuditLog[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model LocationMembership {
  id         String                 @id @default(cuid())
  userId     String
  locationId String
  role       LocationMembershipRole
  isPrimary  Boolean                @default(false)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([userId, locationId])
  @@index([locationId, role])
}

model Amenity {
  id                        String         @id @default(cuid())
  locationId                String
  name                      String
  slug                      String
  type                      AmenityType    @default(OTHER)
  description               String
  imageUrl                  String?
  area                      String
  capacity                  Int
  slotDurationMinutes       Int
  openTime                  String
  closeTime                 String
  rules                     String?
  status                    AmenityStatus  @default(ACTIVE)
  requiresApproval          Boolean        @default(false)
  maxAdvanceDays            Int?
  maxBookingDurationMinutes Int?
  cancellationCutoffHours   Int?
  location                  Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  bookings                  Booking[]
  blackoutDates             BlackoutDate[]
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@unique([locationId, slug])
  @@index([locationId, type, status])
}

model Booking {
  id               String        @id @default(cuid())
  locationId       String
  residentId       String
  amenityId        String
  approvedById     String?
  startAt          DateTime
  endAt            DateTime
  guestCount       Int?
  status           BookingStatus @default(PENDING)
  notes            String?
  eventTitle       String?
  eventDetails     String?
  approvedAt       DateTime?
  cancelledAt      DateTime?
  location         Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resident         User          @relation("ResidentBookings", fields: [residentId], references: [id], onDelete: Cascade)
  amenity          Amenity       @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  approvedBy       User?         @relation("BookingApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([locationId, status, startAt])
  @@index([residentId, status])
  @@index([amenityId, startAt, endAt])
}

model BlackoutDate {
  id         String    @id @default(cuid())
  locationId String
  amenityId  String
  startAt    DateTime
  endAt      DateTime
  reason     String
  allDay     Boolean   @default(false)
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  amenity    Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([locationId, amenityId, startAt, endAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorUserId String?
  locationId  String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([actorUserId])
  @@index([locationId])
  @@index([entityType, entityId])
}
